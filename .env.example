# ==========================================
# INFINIQ Fitness Club - Environment Variables
# Copy this file to .env.local and fill in the values
# ==========================================

# Application URL (used for Origin verification and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Configuration
# For local development/testing, you can use Cloudflare's official dummy test keys:
# Always Passes: Site Key: 1x00000000000000000000AA | Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Future Integrations (TODO):
# RESEND_API_KEY=re_123456789
# LEAD_NOTIFICATION_EMAIL=concierge@infiniqfitness.com
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
